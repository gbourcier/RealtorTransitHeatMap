# ============================================================
# Deployment
# ============================================================
# DATA_DIR: host path where the DB volume and GTFS cache live.
# On a Synology NAS this is typically /volume1/docker/realtor.
DATA_DIR=

# GHCR_OWNER: GitHub user/org that owns the published image.
# IMAGE_TAG: which tag Watchtower should track (main, vX.Y.Z, etc.).
GHCR_OWNER=
IMAGE_TAG=

# Port exposed on the host. The container always listens on 3000 internally.
API_PORT=

# ============================================================
# Database
# ============================================================
POSTGRES_DB=
POSTGRES_USER=
POSTGRES_PASSWORD=

# ============================================================
# Realtor.ca scraper
# ============================================================
REALTOR_BASE_URL=
# Search filters (building type, price range, bed/bath, polygon) are configured
# per-schedule in the UI (Scraper page), not via env.

# Optional bounding box used alongside the per-schedule polygon.
LAT_MAX=
LAT_MIN=
LON_MAX=
LON_MIN=

# Set to true to read from web/mock instead of hitting realtor.ca.
MOCK_REALTOR_API=

# ============================================================
# Transit / GTFS commute precompute
# ============================================================
# Snapshot format: ddd-hh (e.g. tue-09 = Tuesday 09:00).
TRANSIT_SNAPSHOT=

# Reference target the commute is computed *to* (e.g. McGill metro).
TRANSIT_REF_LAT=
TRANSIT_REF_LON=
TRANSIT_REF_KEY=

# How many nearest stops to consider per listing.
TRANSIT_NEAREST_STOPS=

# Walking speed (m/s) and detour factor used in walking time estimates.
TRANSIT_WALK_SPEED_MPS=
TRANSIT_WALK_DETOUR=
