# Copy this file to .env and adjust as needed.

# Database connection
POSTGRES_DB=
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_HOST=
POSTGRES_PORT=
POSTGRES_ENABLE_SSL=
POSTGRES_SEED_DB=

# Realtor API
REALTOR_BASE_URL=
POLYGON_WKT=
