# Copy this file to .env and adjust as needed.

# Database connection
POSTGRES_DB=
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_HOST=
POSTGRES_PORT=
POSTGRES_ENABLE_SSL=
POSTGRES_SEED_DB=

# Realtor API
REALTOR_BASE_URL=
# Mock mode (set to true to use mock/response.json instead of querying realtor.ca)
MOCK_REALTOR_API=false

# Auth — bootstrap admin account (required)
ADMIN_USERNAME=
ADMIN_PASSWORD=
# Set ADMIN_RESET=true to force-reset the admin password on next startup
ADMIN_RESET=false
# Set COOKIE_SECURE=false for local HTTP dev (defaults to true)
COOKIE_SECURE=true
# Set TRUST_PROXY=true ONLY when running behind a reverse proxy you control that
# overwrites X-Forwarded-For; otherwise leave false so rate limiting uses the
# real TCP peer and cannot be bypassed by spoofing the header (defaults to false)
TRUST_PROXY=false
# Session duration (Go duration string, default 720h = 30 days)
SESSION_TTL=720h

# Map viewport bounding box (optional — used alongside the per-schedule polygon)
LAT_MAX=
LAT_MIN=
LON_MAX=
LON_MIN=
